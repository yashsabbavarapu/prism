# Server-only. When set, every write route needs an `x-prism-secret` header with this value.
PRISM_API_SECRET=
# Added by the Vercel KV integration. Without them Prism uses an in-memory store.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional: override the DNS-over-HTTPS endpoint (default https://cloudflare-dns.com/dns-query).
PRISM_DOH_URL=
